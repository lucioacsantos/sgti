# Configuração do backend para usar o LDAP de teste (backend/tests/ldap)
# Copie/ajuste as variáveis relevantes no backend/.env ou exporte antes de rodar.

AD_SERVER=ldap://127.0.0.1
AD_PORT=389
AD_DOMAIN=lacstech.local
AD_BASE_DN=dc=lacstech,dc=local
AD_USE_SSL=false
AD_SEARCH_FILTER=(sAMAccountName={username})
AD_GROUP_SEARCH_FILTER=(member={user_dn})

# Mapeamento de grupos -> roles (mesmos nomes do estrutura.ldif)
ROLE_ADMIN=G_GESIN_GOSD_OMIS
ROLE_READ=G_GESIN